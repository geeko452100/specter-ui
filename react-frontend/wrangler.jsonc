{
  "schema": "node_modules/wrangler/config-schema.json",
  "name": "specterui",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "specterui.dev", "custom_domain": true },
    { "pattern": "www.specterui.dev", "custom_domain": true }
  ]
}

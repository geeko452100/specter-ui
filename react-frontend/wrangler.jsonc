{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "specterui",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "specterui.dev", "custom_domain": true },
    { "pattern": "www.specterui.dev", "custom_domain": true },
    // Same Worker/SPA build — App.tsx renders Dashboard at "/" for this
    // hostname instead of Home. See App.tsx's isDashboardHost check.
    { "pattern": "dashboard.specterui.dev", "custom_domain": true }
  ]
}

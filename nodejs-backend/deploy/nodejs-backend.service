[Unit]
Description=SpecterUI nodejs-backend (private job board API)
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/specter-ui/nodejs-backend
EnvironmentFile=/opt/specter-ui/nodejs-backend/.env
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/specter-ui/nodejs-backend

[Install]
WantedBy=multi-user.target

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "specter-job-board-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  // Needed by unpdf/pdf.js (routes/guestMatch.ts) for PDF text extraction.
  // No filesystem access either way — R2 is storage.
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    {
      "binding": "POSTINGS_BUCKET",
      "bucket_name": "specter-job-postings"
    }
  ],
  // Rate-limits guest resume uploads per IP (see routes/guestMatch.ts) to
  // blunt abuse of the public matching endpoint.
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT",
      "id": "ee8cde505e9b45f9a92bb98972bfb104"
    }
  ],
  "vars": {
    "CONTACT_TO_ADDRESS": "ggriffith288@gmail.com",
    // specterui.dev is verified in Resend, so we send from our own domain
    // rather than the onboarding@resend.dev sandbox address.
    "CONTACT_FROM_ADDRESS": "contact@specterui.dev",
    // The frontend's live hostnames — see index.ts for how this is
    // split/applied. Without this, CORS is off and cross-origin browser
    // requests from the frontend (Contact form, guest resume upload) fail
    // with a NetworkError even though the API itself works fine.
    "CORS_ORIGIN": "https://specterui.dev,https://www.specterui.dev"
  },
  // Single hostname for everything — the frontend's VITE_API_BASE_URL
  // points here for both /guest/match (job dashboard) and /contact.
  "routes": [{ "pattern": "api.specterui.dev", "custom_domain": true }]
  // RESEND_API_KEY is a secret, not a var — set with:
  //   wrangler secret put RESEND_API_KEY
  // (Resend API key: create a free account at resend.com, then an API key
  // under API Keys. Free tier is 3,000 emails/month.)
}

PORT=4000

# Shared secret for the private job board. Generate one long random value,
# e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_TOKEN=

# Path to python-crawler's JSON export, relative to this directory.
POSTINGS_JSON_PATH=../python-crawler/data/postings.json

# Leave unset unless a frontend needs to call this API cross-origin.
CORS_ORIGIN=

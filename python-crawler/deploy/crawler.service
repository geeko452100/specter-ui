[Unit]
Description=SpecterUI job crawler (one run)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/opt/specter-ui/python-crawler
EnvironmentFile=/opt/specter-ui/python-crawler/.env
ExecStart=/opt/specter-ui/python-crawler/.venv/bin/python -m crawler.run

# Hardening: this process only needs to read/write its own working
# directory and make outbound HTTPS requests — no reason to give it more.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/specter-ui/python-crawler/data

# Contact email embedded in the crawler's User-Agent string so a site
# operator can identify this bot and reach out about its traffic.
CRAWLER_CONTACT_EMAIL=you@example.com

# Connection string from your Neon (neon.tech) project's console —
# Dashboard -> your project -> Connection Details. Either the pooled or
# direct connection string works fine for this crawler (one short-lived
# connection per run, every 6 hours); Neon's own default recommendation is
# the pooled one. Includes sslmode=require, which Neon requires.
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/specter_jobs?sslmode=require

# R2 upload — the hand-off to nodejs-backend (a Cloudflare Worker with no
# filesystem of its own). All four required together; leave all blank to
# skip the upload and only write the local file (fine for local dev, but
# in the GitHub Actions deployment these must be set or nodejs-backend
# never sees new data). Create an API token under Cloudflare dashboard ->
# R2 -> Manage R2 API Tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=specter-job-postings

# Contact email embedded in the crawler's User-Agent string so a site
# operator can identify this bot and reach out about its traffic.
CRAWLER_CONTACT_EMAIL=you@example.com

# Postgres connection string. The default matches `docker-compose.yml` in
# this folder (`docker compose up -d`) — change it if you're pointing at a
# different Postgres instance.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/specter_jobs
